# =============================================================================
# Towncenter — copy this file to `.env.local` and fill it in.
#
#   cp .env.example .env.local
#
# `.env.local` is gitignored. No secret is ever copied into a tracked file, not
# even "temporarily": git history keeps everything.
# =============================================================================

# -----------------------------------------------------------------------------
# REQUIRED — the gate
# -----------------------------------------------------------------------------
# Signs session tokens. 32 characters MINIMUM: the application refuses to start
# below that. Generate one with `openssl rand -base64 48`.
# Changing it logs everyone out, which is exactly what you want the day you
# suspect it leaked.
AUTH_SECRET=

# -----------------------------------------------------------------------------
# REQUIRED — the database
# -----------------------------------------------------------------------------
# Postgres 14 or later. The value below matches the bundled `docker-compose.yml`
# and works as it is for local development.
# On a managed host the Postgres service supplies DATABASE_URL itself; do not
# paste it by hand.
DATABASE_URL=postgres://towncenter:towncenter@localhost:5455/towncenter

# -----------------------------------------------------------------------------
# REQUIRED BY ENRICHMENT, AND BY NOTHING ELSE
# -----------------------------------------------------------------------------
# Google Places API (New) key. Server-side only; it never reaches the browser.
# Google Cloud console > APIs & Services > Credentials. Enable "Places API
# (New)" and restrict the key to that single API.
#
# Without it the application starts, connects, shows the map, harvests a whole
# sector and computes every score; only the two enrichment actions refuse to
# run, and they say what to do. There is no working key-less mode:
# `targets.website_url` is only ever written from Google Places' `websiteUri`,
# so without a key no business has a website and the site audit never has
# anything to audit.
GOOGLE_PLACES_API_KEY=

# -----------------------------------------------------------------------------
# OPTIONAL — who is allowed to sign up
# -----------------------------------------------------------------------------
# The FIRST account created owns the instance and CLOSES signups (the Miniflux,
# Gitea, Vaultwarden and Plausible pattern). Set this to reopen signups once
# that first account exists. Absent: only the first signup is possible.
#
# WARNING: between deployment and that first signup the instance is up for
# grabs. There is no invite code — the guard is operational, not software. Sign
# up before the instance is reachable, especially if it already holds data.
# ALLOW_SIGNUPS=true

# -----------------------------------------------------------------------------
# OPTIONAL — the public origin, for link previews only
# -----------------------------------------------------------------------------
# The absolute origin `app/opengraph-image.png` is resolved against when a link
# to this instance is pasted into a chat or a social network. Nothing else reads
# it: the application does not build its own links.
#
# Set it to the origin this instance is served from, scheme included. Left
# unset, previews point at localhost and no crawler can fetch the image — the
# card degrades to a bare link, silently.
# APP_URL=https://towncenter.example.com
