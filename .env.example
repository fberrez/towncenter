# Towncenter — copy to `.env.local` and fill in. `.env.local` is gitignored.

# AUTH_SECRET — signs session tokens. 32 characters minimum (enforced at boot).
# Generate with `openssl rand -base64 48`. Changing it logs everyone out.
AUTH_SECRET=

# DATABASE_URL — Postgres 14+. The value below matches docker-compose.yml.
DATABASE_URL=postgres://towncenter:towncenter@localhost:5455/towncenter

# GOOGLE_PLACES_API_KEY — Places API (New). Server-side only, never reaches
# the browser. Required for enrichment; everything else is free and key-less.
# There is no working key-less mode: `targets.website_url` only comes from
# Google Places, so without a key the site audit never runs.
GOOGLE_PLACES_API_KEY=

# ALLOW_SIGNUPS — the first account created owns the instance and closes
# signups (Miniflux / Gitea / Vaultwarden / Plausible pattern). Set this to
# reopen signups afterwards.
# ALLOW_SIGNUPS=true

# APP_URL — public origin for link previews only. Left unset, previews point
# at localhost and crawlers cannot fetch the image.
# APP_URL=https://towncenter.example.com
